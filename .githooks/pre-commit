#!/usr/bin/env sh
# Block direct commits to the default branch and guard against
# Deft Directive being reinstalled.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$branch" in
  main)
    echo "pre-commit: direct commits to '$branch' are blocked. Use a feature branch." >&2
    exit 1 ;;
esac

readded=$(git diff --cached --name-only --diff-filter=AM \
    | grep -E '^(\.deft/|\.agents/|\.claude/settings\.json|\.claude/(commands|skills)/deft|\.cursor/hooks\.json|\.grok/hooks/|\.codex/|xbrief/schemas/|\.githooks/_(deft|directive)-run\.sh)' || true)
if [ -n "$readded" ]; then
    echo "pre-commit: Deft Directive artifacts are staged:" >&2
    echo "$readded" | sed 's/^/  /' >&2
    exit 1
fi
