REDIS_URL=redis://localhost:6379
CHEETAH_API_KEYS=test-key-1,test-key-2
AI_ENDPOINT_URL=
AI_API_KEY=
# Set to true only when a worker is consuming the transcript_jobs stream; it
# enables the extract_transcript MCP tool (YouTube transcripts). Off by default.
# With this on, the gateway checks for a live transcript worker (a consumer of
# group transcript-workers on transcript_jobs seen in the last 30 s) before
# queueing a job, and /v1/health reports "degraded" while there is none.
TRANSCRIPT_WORKER_ENABLED=false

# Transcript worker settings (read by the transcript-worker compose service, which only starts with
# `docker compose --profile transcript up`). All optional; these are the defaults.
# How long a successfully fetched transcript is cached, in seconds. 0 turns the cache off. The cache
# holds third-party caption text, so this is also how long that text is retained.
TRANSCRIPT_CACHE_TTL_SECONDS=86400
# Minimum seconds between two requests to YouTube from one worker.
TRANSCRIPT_RATE_INTERVAL_SECONDS=3
# Jobs run at once (1-8), the time one job may take in seconds (10-100), and tries per YouTube
# request when it is rate limited or times out (1-5).
TRANSCRIPT_CONCURRENCY=2
TRANSCRIPT_JOB_TIMEOUT_SECONDS=90
TRANSCRIPT_MAX_ATTEMPTS=3
